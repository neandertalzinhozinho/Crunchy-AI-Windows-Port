# Rust build artifacts
/target
**/target

# Bundled binary assets — provisioned locally via scripts/setup-assets.sh, not tracked in git
/assets/models/*.onnx
/assets/models/*.weights.f32
/assets/lib/*.so*
/assets/lib/*.dll
/tests/fixtures/*.wav

# Release build outputs + provisioning scratch
/dist
/.venv-assets
/.build-tools

# Editor / OS cruft
*.swp
*~
.DS_Store

# demo clips are rebuilt by docs/demo/make-demos.py and attached at publish time
/docs/demo/build/
/docs/demo/*.mp4
.deploy-host

# Raw icon exports (bulky, metadata-laden ~1 MB each); the cleaned masters
# and the hicolor ladder are the committed artifacts.
/packaging/tray/tray*.png
/packaging/flatpak/ci-tree-manifest.yml

# Python bytecode (the ci/ scripts import each other in tests)
__pycache__/

# Windows port: downloaded models/runtime, driver intermediate outputs.
/windows/assets/
!/windows/assets/
!/windows/assets/crunchy-ai-icon.png
!/windows/assets/crunchy-ai.ico
/windows/driver/**/x64/
/windows/driver/**/ARM64/
/windows/driver/**/Debug/
/windows/driver/**/Release/
*.user
